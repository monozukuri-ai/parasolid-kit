# Viewer assets are hash-pinned at build time and runtime on every platform.
/src/parasolid_kit/interop/preview/static/*.html text eol=lf
# Generated bundles preserve upstream license/template/shader whitespace verbatim.
/src/parasolid_kit/interop/preview/static/*.css text eol=lf -whitespace
/src/parasolid_kit/interop/preview/static/*.js text eol=lf -whitespace
/viewer/** text eol=lf
/viewer/**/*.glb -text
/viewer/third-party/*.txt -text -whitespace

# Release baselines and synthetic wire bytes are hash-pinned on every platform.
/corpus/expected/**/*.json text eol=lf
/corpus/generated/synthetic/**/*.x_t -text
/corpus/generated/synthetic/**/*.x_b -text

# Compare distributed licenses byte-for-byte across all wheel platforms.
/LICENSE text eol=lf
/LICENSES/*.txt text eol=lf
/crates/parasolid-core/LICENSE* text eol=lf
